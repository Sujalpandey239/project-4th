   "source": [
    "class_counts = []\n",
    "\n",
    "for crop in DATASET_PATH.iterdir():\n",
    "\n",
    "    train_folder = crop / \"Train\"\n",
    "\n",
    "    if train_folder.exists():\n",
    "\n",
    "        for disease in train_folder.iterdir():\n",
    "\n",
    "            if disease.is_dir():\n",
    "\n",
    "                image_count = len(list(disease.glob(\"*\")))\n",
    "\n",
    "                class_counts.append(\n",
    "                    {\n",
    "                        \"Crop\": crop.name,\n",
    "                        \"Disease\": disease.name,\n",
    "                        \"Train Images\": image_count\n",
    "                    }\n",
    "                )\n",
    "\n",
    "df = pd.DataFrame(class_counts)\n",
    "\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2c1e4136",
   "metadata": {},
   "outputs": [],
   "source": [
