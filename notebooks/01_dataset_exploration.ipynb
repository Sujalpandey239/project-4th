    "disease_classes = []\n",
    "\n",
    "for crop in DATASET_PATH.iterdir():\n",
    "\n",
    "    train_folder = crop / \"Train\"\n",
    "\n",
    "    if train_folder.exists():\n",
    "\n",
    "        for disease in train_folder.iterdir():\n",
    "\n",
    "            if disease.is_dir():\n",
    "\n",
    "                disease_classes.append(\n",
    "                    f\"{crop.name} - {disease.name}\"\n",
    "                )\n",
    "\n",
    "print(\"Total Classes:\", len(disease_classes))"
   ]
